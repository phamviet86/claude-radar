{
  "name": "claude-radar",
  "version": "0.1.0",
  "description": "A read-only radar for Claude Code threads in Claude desktop: what needs you, what is running, what is done",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "demo": "node demo/run.mjs",
    "screenshots": "electron demo/screenshots.mjs",
    "test": "node --test test/",
    "check": "tsc",
    "app": "electron .",
    "icons": "node desktop/make-icons.mjs",
    "build": "node desktop/build-icns.mjs && electron-builder --mac dir"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3"
  },
  "main": "desktop/main.js",
  "build": {
    "appId": "local.phamviet86.claude-radar",
    "productName": "Claude Radar",
    "files": [
      "server.js",
      "lib/**",
      "public/**",
      "desktop/main.js",
      "desktop/keystore.js",
      "desktop/keys.html",
      "desktop/preload.cjs",
      "desktop/*.png",
      "package.json"
    ],
    "mac": {
      "icon": "desktop/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": "dir"
    },
    "directories": {
      "output": "dist"
    }
  }
}
