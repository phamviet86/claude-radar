{
  "name": "thread-board",
  "version": "0.1.0",
  "description": "Bảng Kanban chỉ đọc cho các thread Claude Code trong Claude desktop",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/",
    "app": "electron .",
    "icons": "node desktop/make-icons.mjs",
    "build": "node desktop/build-icns.mjs && electron-builder --mac dir"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "main": "desktop/main.js",
  "build": {
    "appId": "local.phamviet86.thread-board",
    "productName": "Thread Board",
    "files": [
      "server.js",
      "lib/**",
      "public/**",
      "desktop/main.js",
      "desktop/*.png",
      "package.json"
    ],
    "mac": {
      "icon": "desktop/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": "dir"
    },
    "directories": {
      "output": "dist"
    }
  }
}
